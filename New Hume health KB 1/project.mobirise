      "settings": {
        "main": true,
        "title": "Humehealth™ Body Pod | USA Official Site",
        "meta_descr": "Hume Health Body Pod is a smart, full-body composition analyzer that uses advanced multi-frequency BIA (bioelectrical impedance analysis)\nand an 8-electrode system to measure the internal structure of your body. Unlike a typical smart scale, which only collects data from your\nfeet, the Body Pod also uses handheld electrodes - giving you more data from your upper body, torso, and limbs.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/oip%20(1).webp"
